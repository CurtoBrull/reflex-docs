# Django Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# REQUIRED: Django secret key (must be at least 50 characters)
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-must-be-at-least-50-characters-long-change-this

# DEBUG mode (set to False in production)
# Values: True, False
DEBUG=True

# Allowed hosts (comma-separated list of domains)
# For development: localhost,127.0.0.1
# For production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration - PostgreSQL 16
# The system uses PostgreSQL as the production database with psycopg2-binary adapter
# All database credentials are read from these environment variables
# Validates: Requirements 2.1, 2.2, 2.3, 2.5

# PostgreSQL connection settings (REQUIRED)
DB_NAME=reflex_docs_db
DB_USER=reflex_docs_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432
